{
  "$id": "https://gcn.nasa.gov/schema/main/gcn/notices/derived_circular/LightCurve.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Light Curve",
  "description": "Brightness measurements of one source extracted from the text of GCN Circulars, with one row per reported measurement. Each row carries its own epoch, telescope and calibration, since a light curve assembled from Circulars combines many observers. Units follow the core Spectral and Photometry schemas.",
  "allOf": [
    {
      "$ref": "../core/Event.schema.json",
      "description": "Name of the source the measurements belong to"
    },
    {
      "$ref": "../core/FollowUp.schema.json",
      "description": "Event the measurements follow up (e.g., the GRB or GW trigger)"
    }
  ],
  "required": ["measurements"],
  "properties": {
    "measurements": {
      "type": "array",
      "minItems": 1,
      "description": "Measurements of the source, one per band and epoch.",
      "items": { "$ref": "#/$defs/measurement" }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "title": "Measurement",
      "description": "One brightness measurement, as a magnitude, a flux density or a band-integrated flux.",
      "required": ["band", "value", "is_detection"],
      "properties": {
        "circular_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of the GCN Circular that reported this measurement (circularId in the GCN Circulars schema)."
        },
        "time": {
          "type": "string",
          "format": "date-time",
          "description": "Mid-exposure epoch of this measurement [ISO 8601, UTC]."
        },
        "observation_livetime": {
          "$ref": "../core/DateTime.schema.json#/properties/observation_livetime",
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Livetime of the observation this measurement came from [s]."
        },
        "mission": {
          "$ref": "../core/Reporter.schema.json#/properties/mission",
          "description": "Mission or telescope that made this measurement (e.g., GTC, ZTF, VLA)."
        },
        "instrument": {
          "$ref": "../core/Reporter.schema.json#/properties/instrument",
          "description": "Instrument that made this measurement, where it is distinguished from the telescope (e.g., OSIRIS, EP-FXT)."
        },
        "band": {
          "description": "Part of the spectrum measured.",
          "oneOf": [
            {
              "type": "object",
              "title": "Named filter",
              "required": ["filter"],
              "properties": {
                "filter": {
                  "$ref": "../core/Photometry.schema.json#/properties/filter"
                },
                "filter_id": {
                  "type": "string",
                  "description": "Canonical identifier for the filter, preferably an SVO Filter Profile Service id (e.g., SLOAN/SDSS.r)."
                }
              }
            },
            {
              "type": "object",
              "title": "Point on the spectrum",
              "required": ["spectral_point", "spectral_unit"],
              "properties": {
                "spectral_point": {
                  "$ref": "../core/Spectral.schema.json#/properties/flux_density_spectral_point"
                },
                "spectral_unit": {
                  "$ref": "../core/Spectral.schema.json#/properties/flux_density_spectral_point_unit"
                }
              }
            },
            {
              "type": "object",
              "title": "Bounded band",
              "required": ["spectral_band", "spectral_unit"],
              "properties": {
                "spectral_band": {
                  "$ref": "../core/Spectral.schema.json#/properties/flux_spectral_band"
                },
                "spectral_unit": {
                  "$ref": "../core/Spectral.schema.json#/properties/flux_spectral_unit"
                }
              }
            }
          ]
        },
        "value": {
          "type": "number",
          "description": "Measured value where is_detection is true, upper limit where it is false."
        },
        "value_error": {
          "description": "1-sigma statistical uncertainty on value, in the same unit.",
          "oneOf": [
            {
              "type": "number",
              "description": "Symmetric statistical error."
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Asymmetric statistical errors."
            }
          ]
        },
        "is_detection": {
          "type": "boolean",
          "description": "True where value is a measurement, false where it is an upper limit."
        },
        "limit_sigma": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Significance of the upper limit [sigma], where is_detection is false. Circulars most often quote 3."
        },
        "extinction_corrected": {
          "type": "boolean",
          "description": "True where Galactic extinction has already been removed from value."
        },
        "calibration_reference": {
          "type": "string",
          "description": "Catalogue the measurement was calibrated against (e.g., PS1, SDSS, APASS, 2MASS, Gaia)."
        }
      },
      "oneOf": [
        {
          "title": "Apparent magnitude",
          "required": ["kind", "unit"],
          "properties": {
            "kind": {
              "const": "magnitude"
            },
            "unit": {
              "$ref": "../core/Photometry.schema.json#/properties/mag_system"
            }
          }
        },
        {
          "title": "Flux density",
          "required": ["kind", "unit"],
          "properties": {
            "kind": {
              "const": "flux_density"
            },
            "unit": {
              "$ref": "../core/Spectral.schema.json#/properties/flux_density_unit"
            }
          }
        },
        {
          "title": "Band-integrated flux",
          "required": ["kind", "unit"],
          "properties": {
            "kind": {
              "const": "flux"
            },
            "unit": {
              "$ref": "../core/Spectral.schema.json#/properties/flux_unit"
            }
          }
        }
      ]
    }
  }
}
